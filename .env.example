# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# You can also set the Discord token from the Gremlin settings page
# (Discord card); it is written to `.env` automatically on save.

# Discord bot token (https://discord.com/developers/applications -> Bot -> Reset Token)
GREMLIN_DISCORD_TOKEN=

# --- Grav CMS (grav_mcp tool) --------------------------------------------
# Used by the `grav_mcp` tool to talk to the Grav MCP server.
# The API key is read from here and never logged.

# Required (stdio transport): Grav API base URL (include /api, e.g. http://127.0.0.1:8000/api)
GRAV_API_URL=
# Required (stdio transport): Grav API key / token
GRAV_API_KEY=

# Optional: 'stdio' (default, Gremlin spawns `npx -y grav-mcp`) or 'http'
GRAV_MCP_TRANSPORT=stdio
# Optional (http transport): MCP endpoint of a separately-started server,
# e.g. start one with: npx grav-mcp --url ... --key ... --transport http --port 3100
GRAV_MCP_HTTP_URL=
# Optional (stdio transport): override the launch command / args
#GRAV_MCP_COMMAND=npx
#GRAV_MCP_ARGS=-y grav-mcp
